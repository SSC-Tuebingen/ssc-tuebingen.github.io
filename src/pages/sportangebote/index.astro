---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const departments = [
  ['fussball', 'Fußball', 'Aktive, Junioren und Bambini'],
  ['volleyball', 'Volleyball', 'Jugend-, Damen- und Herrenteams'],
  ['american-football', 'American Football', 'Red Knights, Flag Football und Jugend'],
  ['cheerleading', 'Cheerleading', 'Dragons von Peewees bis Seniors'],
  ['tanzen', 'Tanzen', 'Tanztraining für Kinder'],
  ['kindersport', 'Kindersport', 'Freude an Spiel und Bewegung'],
];
const otherOffers = [
  ['inklusion', 'Inklusion', 'Tübingen United'],
  ['lauftreff', 'Lauftreff', 'Laufen und Nordic Walking'],
];
---
<BaseLayout title="Sportangebote – SSC Tübingen" description="Alle Sportangebote des SSC Tübingen.">
  <PageHero eyebrow="Sportangebote" title="Finde deinen Sport" intro="Ob Teamsport, Bewegung für Kinder oder gemeinsames Laufen: Beim SSC gibt es viele Wege, aktiv zu werden." />
  <section class="section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Abteilungen</p><h2>Unsere Abteilungen</h2><p class="lede">Mannschaften, Gruppen und Ansprechpersonen auf einen Blick.</p></div></div><div class="card-grid">{departments.map(([slug, name, description]) => <a class="sport-card" href={`/sportangebote/${slug}/`} data-mark={name.charAt(0)}><h3>{name}</h3><p>{description}</p></a>)}</div></div></section>
  <section class="section section-soft"><div class="shell"><div class="section-head"><div><p class="eyebrow">Weitere Sportangebote</p><h2>Offen und gemeinsam aktiv</h2></div></div><div class="card-grid card-grid-compact">{otherOffers.map(([slug, name, description]) => <a class="sport-card" href={`/sportangebote/${slug}/`} data-mark={name.charAt(0)}><h3>{name}</h3><p>{description}</p></a>)}</div></div></section>
</BaseLayout>
