---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  socialImage?: string | null;
}

const { title, description, socialImage = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const absoluteSocialImage = socialImage ? new URL(socialImage, Astro.site) : null;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#800130" />
    <link rel="icon" href="/images/ssc-logo.jpg" type="image/jpeg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SSC Tübingen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {absoluteSocialImage && <meta property="og:image" content={absoluteSocialImage} />}
    <meta name="twitter:card" content={absoluteSocialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteSocialImage && <meta name="twitter:image" content={absoluteSocialImage} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <aside class="construction-banner" aria-label="Hinweis zur Website">
      <div class="shell construction-banner-inner">
        <strong>Website im Aufbau</strong>
        <p>
          Diese Website befindet sich noch im Aufbau. Die offizielle Website des SSC Tübingen finden Sie weiterhin unter
          <a href="https://www.ssc-tuebingen.de/">ssc-tuebingen.de</a>.
        </p>
      </div>
    </aside>
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>
