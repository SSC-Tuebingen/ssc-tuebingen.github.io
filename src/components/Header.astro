---
const path = Astro.url.pathname;
const links = [
  { href: '/aktuelles/', label: 'Aktuelles' },
  { href: '/sportangebote/', label: 'Sportangebote' },
  { href: '/trainingszeiten/', label: 'Trainingszeiten' },
  { href: '/verein/', label: 'Verein' },
  { href: '/kontakt/', label: 'Kontakt' },
];
---

<header class="site-header">
  <div class="header-bar shell">
    <a class="brand" href="/" aria-label="SSC Tübingen – Startseite">
      <img
        class="brand-logo"
        src="/images/ssc-logo.jpg"
        alt=""
        width="3000"
        height="4145"
        decoding="async"
      />
      <span class="brand-copy">
        <strong>SSC Tübingen</strong>
        <small>Sport. Gemeinschaft. Seit 1988.</small>
      </span>
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-nav">
      <span aria-hidden="true">☰</span> Menü
    </button>
    <nav id="main-nav" class="main-nav" aria-label="Hauptnavigation">
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const navigation = document.querySelector<HTMLElement>('#main-nav');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    navigation?.classList.toggle('is-open', !open);
  });
</script>
